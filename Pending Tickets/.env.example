# Copy this file to ".env" and fill in your values.

# Your Freshdesk domain, e.g. "acme" for https://acme.freshdesk.com
FRESHDESK_DOMAIN=yourcompany

# Your Freshdesk API key (Profile Settings -> Your API Key)
FRESHDESK_API_KEY=your_api_key_here

# Number of days a ticket must be older than to appear (default 3)
AGE_THRESHOLD_DAYS=3

# Optional: only include tickets that are not resolved/closed (true/false)
EXCLUDE_CLOSED=true

# Flask settings (optional)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ---------------------------------------------------------------------------
# Email alerts (optional)
# When enabled, an email is sent listing tickets that NEWLY crossed the age
# threshold since the last check. Already-alerted tickets are remembered in
# ALERT_STATE_FILE so you don't get duplicate alerts for the same ticket.
# ---------------------------------------------------------------------------
ALERTS_ENABLED=false
ALERT_RECIPIENT=alerts@example.com

# SMTP server used to send the alert emails.
# Example for Office 365: smtp.office365.com / port 587 / TLS on.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# From address (defaults to SMTP_USER if left blank)
SMTP_FROM=
SMTP_USE_TLS=true

# Where the "already alerted" ticket ids are stored (JSON).
ALERT_STATE_FILE=.alerted_tickets.json

# ---------------------------------------------------------------------------
# Built-in scheduler (optional)
# When enabled, the app checks for aged tickets on a timer and sends alerts
# automatically (no external cron / Task Scheduler needed). Requires the email
# alert settings above to actually send mail.
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Sharing the dashboard with colleagues (production server + login)
# Used by:  python app.py --serve
# ---------------------------------------------------------------------------
# Interface to bind. 0.0.0.0 makes it reachable from other machines on the LAN;
# use 127.0.0.1 to keep it local-only.
SERVE_HOST=0.0.0.0
SERVE_PORT=8080

# Shared login for the dashboard (HTTP Basic Auth). STRONGLY recommended when
# binding to 0.0.0.0, since the dashboard shows live ticket data. If either is
# blank, the dashboard runs WITHOUT a login and logs a warning.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
